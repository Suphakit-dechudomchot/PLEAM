[sub_resource type="Shader" id="Shader_bs814"]
code = "shader_type spatial;

// --- ส่วนที่ให้คุณปรับใน Inspector ---
uniform vec4 water_color : source_color = vec4(0.0, 0.5, 1.0, 0.5);
uniform float roughness : hint_range(0.0, 1.0) = 0.1;
uniform sampler2D texture_normal;
uniform float scroll_speed = 2;

// เพิ่มตัวแปร UV1 เหมือน Material ปกติ
uniform vec3 uv1_scale = vec3(1.0, 1.0, 1.0);
uniform vec3 uv1_offset = vec3(0.0, 0.0, 0.0);
// ----------------------------------

varying vec3 uv1_triplanar_pos;
varying vec3 uv1_power_normal;

void vertex() {
	// คำนวณ Triplanar โดยใช้ค่า Scale และ Offset ที่คุณตั้ง
	uv1_power_normal = pow(abs(NORMAL), vec3(10.0));
	uv1_power_normal /= dot(uv1_power_normal, vec3(1.0));

	// นำ uv1_scale และ uv1_offset มาคำนวณตำแหน่งลายน้ำ
	uv1_triplanar_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz * uv1_scale + uv1_offset;

	// สั่งให้น้ำไหล
	uv1_triplanar_pos.xz += TIME * scroll_speed;
}

vec4 triplanar_texture(sampler2D p_sampler, vec3 p_weights, vec3 p_triplanar_pos) {
	vec4 samp = vec4(0.0);
	samp += texture(p_sampler, p_triplanar_pos.xy) * p_weights.z;
	samp += texture(p_sampler, p_triplanar_pos.xz) * p_weights.y;
	samp += texture(p_sampler, p_triplanar_pos.zy) * p_weights.x;
	return samp;
}

void fragment() {
	ALBEDO = water_color.rgb;
	ALPHA = water_color.a;
	ROUGHNESS = roughness;

	// ดึงค่า Normal Map มาใช้
	NORMAL_MAP = triplanar_texture(texture_normal, uv1_power_normal, uv1_triplanar_pos).rgb;
}"

