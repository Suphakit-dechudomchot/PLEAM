[sub_resource type="GDScript" id="GDScript_st3dd"]
script/source = "extends Node3D

@export_group(\"Time Settings\")
@export_range(0, 24) var current_time: float = 6.5
@export var day_length_seconds: float = 60.0       
@export var cloud_speed_multiplier: float = 0.2 
@export var time_running: bool = true # <--- เพิ่มตัวแปรนี้เพื่อเปิด-ปิดการเดินของเวลา

@export_group(\"Sun Appearance\")
@export var constant_sun_size: float = 2.5 

@export_group(\"References\")
@export var sun_light: DirectionalLight3D
@export var world_env: WorldEnvironment

# --- (sky_data ชุดเดิมที่คุณใช้อยู่) ---
var sky_data = {
    0.0:  {\"top\": Color(\"020205\"), \"hor\": Color(\"050510\"), \"energy\": 0.0}, 
    5.0:  {\"top\": Color(\"0a1128\"), \"hor\": Color(\"1a1a2e\"), \"energy\": 0.0},
    6.5:  {\"top\": Color(\"1a3a6d\"), \"hor\": Color(\"d35400\"), \"energy\": 0.45},
    9.0:  {\"top\": Color(\"102a52\"), \"hor\": Color(\"4a90e2\"), \"energy\": 0.75},
    12.0: {\"top\": Color(\"0b3d91\"), \"hor\": Color(\"3498db\"), \"energy\": 0.9},
    17.5: {\"top\": Color(\"341f47\"), \"hor\": Color(\"c0392b\"), \"energy\": 0.8},
    19.0: {\"top\": Color(\"0a1128\"), \"hor\": Color(\"1a1a2e\"), \"energy\": 0.1},
    21.0: {\"top\": Color(\"020205\"), \"hor\": Color(\"050510\"), \"energy\": 0.0}
}

var total_cloud_time: float = 0.0

func _process(delta: float) -> void:
    # ตรวจสอบว่าเปิดให้เวลาเดินหรือไม่
    if time_running:
        var time_step = (delta / day_length_seconds) * 24.0
        current_time += time_step
        if current_time >= 24.0: current_time = 0.0
        
        # ให้เมฆขยับเฉพาะตอนเวลาเดิน (หรือจะแยกกันก็ได้แล้วแต่ชอบครับ)
        
    
    # อัปเดตระบบแสงและสีเสมอ เพื่อให้เวลาเราลากแถบ current_time ใน Inspector แล้วสีเปลี่ยนตามทันที
    total_cloud_time += delta * cloud_speed_multiplier
    _update_system()

func _update_system():
    var rot_x = ((current_time - 6.0) / 12.0) * 180.0
    if sun_light:
        sun_light.rotation_degrees = Vector3(-rot_x, -90, 0)
        sun_light.visible = (current_time > 5.2 and current_time < 18.8)
    
    _interpolate_sky_colors()

func _interpolate_sky_colors():
    var keys = sky_data.keys()
    keys.sort()
    
    var before_key = keys[0]
    var after_key = keys[0]
    for i in range(keys.size()):
        if current_time >= keys[i]:
            before_key = keys[i]
            after_key = keys[(i + 1) % keys.size()]
    
    var duration = after_key - before_key
    if duration <= 0: duration += 24.0
    var weight = (current_time - before_key) / duration
    
    var t_top = sky_data[before_key][\"top\"].lerp(sky_data[after_key][\"top\"], weight)
    var t_hor = sky_data[before_key][\"hor\"].lerp(sky_data[after_key][\"hor\"], weight)
    var t_energy = lerp(sky_data[before_key][\"energy\"], sky_data[after_key][\"energy\"], weight)

    if world_env and world_env.environment and world_env.environment.sky:
        var mat = world_env.environment.sky.sky_material
        if mat is ShaderMaterial:
            mat.set_shader_parameter(\"top_color\", t_top)
            mat.set_shader_parameter(\"bottom_color\", t_hor)
            mat.set_shader_parameter(\"sun_energy\", t_energy)
            
            var cloud_col = t_hor.lerp(Color.WHITE, 0.4)
            mat.set_shader_parameter(\"clouds_light_color\", cloud_col)
            
            var scatter_darkness = 0.5 if (current_time > 7.0 and current_time < 11.0) else 0.3
            mat.set_shader_parameter(\"sun_scatter\", t_hor.darkened(scatter_darkness))
            
            mat.set_shader_parameter(\"astro_scale\", constant_sun_size)
            mat.set_shader_parameter(\"cloud_time_offset\", total_cloud_time)
            
            var star_val = smoothstep(5.5, 4.0, current_time) + smoothstep(18.5, 20.0, current_time)
            mat.set_shader_parameter(\"stars_intensity\", clamp(star_val * 1.5, 0.0, 1.5))
            
    if sun_light:
        sun_light.light_energy = t_energy
        sun_light.light_color = t_hor.lerp(Color.WHITE, 0.2)
"

